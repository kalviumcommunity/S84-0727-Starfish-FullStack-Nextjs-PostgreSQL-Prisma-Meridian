# Copy this file to `.env` and fill in your values.
# Meridian runs as a single app — one process serves UI + API.

# --- Required (Phase 1) ---

# PostgreSQL connection string.
# Free options: local Postgres, Neon free tier, Supabase free tier.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret for signing JWT session tokens (use a long random string).
JWT_SECRET="change-me-to-a-long-random-secret"

# Public URL of your app (used for CSRF origin checks).
APP_URL="http://localhost:3000"

# --- Optional (later phases — leave blank until needed) ---

# Phase 2: GitHub personal access token (optional for public repos)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=""

# Phase 5: AI provider API keys (at least one recommended for AI insights)
# Groq (free): https://console.groq.com/keys
# Gemini (free): https://aistudio.google.com/app/apikey
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
